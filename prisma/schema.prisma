generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Problem {
  slug        String       @id
  title       String
  difficulty  String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  submissions Submission[]
}

model Submission {
  id            String   @id @default(cuid())
  problemSlug   String
  language      String
  status        String
  executionTime String?
  memory        Int?
  createdAt     DateTime @default(now())
  problem       Problem  @relation(fields: [problemSlug], references: [slug])

  @@index([problemSlug])
}

model UserProgress {
  id            String   @id @default(cuid())
  userId        String   @unique
  solvedSlugs   String[]
  attemptedSlugs String[]
  updatedAt     DateTime @updatedAt
}
